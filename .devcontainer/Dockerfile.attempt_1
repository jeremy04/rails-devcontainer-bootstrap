# syntax=docker/dockerfile:1
ARG RUBY_VERSION=4.0
FROM ruby:${RUBY_VERSION}-slim AS base

ARG NODE_VERSION=24.12.0
ARG BUNDLER_VERSION=4.0.4
ARG YARN_VERSION=1.22.22

ENV RAILS_SERVE_STATIC_FILES=true
ENV RAILS_LOG_TO_STDOUT=true

RUN mkdir /workspace
WORKDIR /workspace
RUN mkdir -p tmp/pids

FROM base AS build_deps

ARG DEV_PACKAGES="git build-essential libpq-dev wget vim gzip xz-utils libsqlite3-dev libyaml-dev curl unzip"
ENV DEV_PACKAGES=${DEV_PACKAGES}

# Install core dev packages and GitHub CLI
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y ${DEV_PACKAGES} && \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
      https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update -qq && \
    apt-get install --no-install-recommends -y gh && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

# Install Claude Code assistant
RUN curl -fsSL https://claude.ai/install.sh | bash

# Install Volta (Node/Yarn version manager)
SHELL ["/bin/bash", "-c"]
RUN curl https://get.volta.sh | bash
ENV BASH_ENV=~/.bashrc \
    VOLTA_HOME=/root/.volta \
    PATH=/root/.volta/bin:$PATH
RUN volta install node@${NODE_VERSION} && volta install yarn@${YARN_VERSION}

FROM build_deps AS gems

RUN gem install -N bundler -v ${BUNDLER_VERSION}

COPY Gemfile* ./

FROM build_deps AS node_modules

COPY package*json ./
COPY yarn.* ./
